// Exaai data model — conceptual entities from PRD sections 13–15
// Storage technology: PostgreSQL via Neon (serverless, pooled connections).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  language     String   @default("en") // "en" | "fr"
  role         String   @default("teacher") // "teacher" | "admin"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
  exams        Exam[]
  favourites   FavouriteTask[]
  customTasks  CustomTask[]
  passwordResets PasswordResetToken[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exam {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String       @default("Untitled exam")
  status       String       @default("DRAFT") // NEW | DRAFT | ACTIVE | EXPORTED | ARCHIVED
  config       ExamConfig?
  sections     ExamSection[]
  sources      Source[]
  generations  Generation[]
  revisions    ExamRevision[]
  lastOpenedAt DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model ExamConfig {
  id           String @id @default(cuid())
  examId       String @unique
  exam         Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  level        String // middle | secondary
  grade        String
  stream       String?
  length       Int    @default(150) // words
  unit         String
  topic        String
  customTopic     Boolean @default(false)
  guideVersion    String? // guide version used at generation time (PRD 19.3, 47)
  language        String   @default("en") // exam language (PRD 38.1)
  teacherKeywords String? // free-text keywords to bias AI generation
  difficulty      String? // Standard | Harder | Simpler — vocabulary + grammar complexity
}

model ExamSection {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  type      String // TEXT | PART_ONE | TEXT_EXPLORATION | WRITING
  heading   String?
  order     Int      @default(0)
  content   String? // JSON blob of section-level data (e.g. {text, candidates})
  tasks     Task[]
  topics    Topic[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id             String    @id @default(cuid())
  sectionId      String
  section        ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  skill          String? // e.g. VOCABULARY | MORPHOLOGY | PHONOLOGY | GRAMMAR | DISCOURSE | READING
  prompt         String
  instruction    String?
  answer         String?
  marks          Float     @default(1)
  order          Int       @default(0)
  manualEdited   Boolean   @default(false)
  family         String?   // task family: TRUE_FALSE, QUESTIONS, PARAGRAPH_ID, etc.
  tableData      String?   @map("table_data") // JSON: {headers: string[], rows: string[][]} for morphology tables
  generationId   String?
  candidates     String? // JSON array of candidate tasks {prompt, answer, marks}
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Topic {
  id        String   @id @default(cuid())
  sectionId String
  section   ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  kind      String // GUIDED | FREE
  title     String?
  situation String?
  instruction String?
  keywords  String? // slash-separated keywords for guided topic
  form      String?
  marks     Float    @default(5)
  order     Int      @default(0)
  manualEdited Boolean @default(false)
  candidates String? // JSON array of candidate topics
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Source {
  id             String   @id @default(cuid())
  examId         String
  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  sectionId      String?
  title          String?
  author         String?
  publication    String?
  url            String?
  accessedAt     String?
  adaptationNote String?
  isExternal     Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Generation {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  type      String // TEXT | PART_ONE | TEXT_EXPLORATION | WRITING | TASK_ALT | TOPIC_ALT
  provider  String   @default("mock")
  status    String   @default("OK") // OK | ERROR
  error     String?
  createdAt DateTime @default(now())
}

model FavouriteTask {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  content   String // JSON
  createdAt DateTime @default(now())
}

model CustomTask {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  content   String // JSON
  createdAt DateTime @default(now())
}

model GuideConfig {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "ms4", "3as-lang"
  name      String
  version   String
  language  String @default("en") // guide language (PRD 38.1)
  sourceRef String? // link to official guide document
  active    Boolean  @default(true)
  data      String // JSON rule set
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Core product funnel events (PRD section 28). Lightweight analytics: each row
// is one user-visible action, so the funnel and failure rates are queryable
// without a third-party analytics dependency.
model ProductEvent {
  id        String   @id @default(cuid())
  name      String // e.g. signup_completed, exam_created, text_generated
  userId    String?
  examId    String?
  meta      String? // JSON
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, createdAt])
}

// Password reset tokens (PRD section 6). Only the hash is stored; each token is
// single-use and expires.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Password reset attempt tracking for rate limiting
model PasswordResetAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// Version history snapshots (PRD 15.3, US-024). A snapshot captures the exam
// configuration and section content so an earlier state can be restored.
model ExamRevision {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  label     String
  snapshot  String // JSON of config + sections
  createdAt DateTime @default(now())

  @@index([examId, createdAt])
}
