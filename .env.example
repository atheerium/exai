# Exaai environment
# PostgreSQL via Supabase (pooled). Use the pooled connection string from
# the Supabase dashboard (Database → Connect → Transaction pooler) for
# Vercel/serverless functions.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Auth
SESSION_COOKIE_NAME="exai_session"
SESSION_TTL_DAYS=30

# Operators (US-030): comma-separated emails granted admin access to /ops
# ADMIN_EMAILS="you@example.com"

# Public base URL used in account emails (password reset links)
# APP_URL="http://localhost:3000"

# Generation provider: "mock" (default, offline, no API key) | "groq" | "openai"
# | "openrouter" | "nvidia"
AI_PROVIDER="mock"

# Fallback chain (preferred over AI_PROVIDER once you have keys). Entries are
# `provider:model`, tried left to right; see src/lib/generate/chain.ts for the
# advance policy. Roster verified against live free tiers on 2026-10-11 — free
# model lists change quarterly, so re-check before trusting an ID here.
# AI_PROVIDER_CHAIN="groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free,nvidia:nvidia/nemotron-3-super-120b-a12b"
#
# Groq free plan chat models (2026-10-11): openai/gpt-oss-120b,
# openai/gpt-oss-20b, qwen/qwen3.8-27b. All meta-llama/* chat models were
# REMOVED from free tiers on 2026-08-16 — a llama ID here returns 404/429.
# gpt-oss is a reasoning model; the chain caps reasoning automatically, because
# uncapped it returns empty content (measured 0/6 without the cap, 6/6 with).
# Optional: GROQ_BASE_URL, OPENROUTER_BASE_URL, NVIDIA_BASE_URL override the
# default endpoints (useful for a proxy or a self-hosted OpenAI-compatible).

# SMTP (production only — fail-closed if SMTP_HOST is missing)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"   # true/false; default true when port=465
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Exaai <no-reply@exaai.app>"

# Used when AI_PROVIDER="openai"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"   # any OpenAI-compatible endpoint

# Used when AI_PROVIDER="groq"
# GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-120b"
# GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Fallback providers (keys only; models come from AI_PROVIDER_CHAIN above)
# OPENROUTER_API_KEY=""
# NVIDIA_API_KEY=""

# Privacy note: free-tier endpoints may retain or train on prompts. Exam content
# is not sensitive, so this is accepted — recorded here so it stays a decision
# rather than an oversight.
