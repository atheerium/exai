# Exaai environment
# SQLite database for MVP (see prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Auth
SESSION_COOKIE_NAME="exai_session"
SESSION_TTL_DAYS=30

# Generation provider: "mock" (default, deterministic, no API key) | "openai"
AI_PROVIDER="mock"

# Used when AI_PROVIDER="openai"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
